<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7FAFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Screen Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assignments"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#0D47A1"
            android:layout_marginBottom="20dp" />

        <!-- Assignment Title -->
        <EditText
            android:id="@+id/assignmentTitleInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Assignment Title"
            android:inputType="textCapSentences"
            android:padding="10dp"
            android:layout_marginBottom="12dp" />

        <!-- Subject Name -->
        <EditText
            android:id="@+id/assignmentSubjectInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Subject Name"
            android:inputType="textCapWords"
            android:padding="10dp"
            android:layout_marginBottom="12dp" />

        <!-- Due Date -->
        <EditText
            android:id="@+id/assignmentDueDateInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Due Date (DD/MM/YYYY)"
            android:inputType="text"
            android:padding="10dp"
            android:layout_marginBottom="20dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/saveAssignmentBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Add Assignment"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1976D2"
            android:textStyle="bold"
            android:layout_marginBottom="25dp" />

        <!-- Saved Assignments Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saved Assignments"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#0D47A1"
            android:layout_marginBottom="10dp" />

        <!-- Initial Empty Message -->
        <TextView
            android:id="@+id/assignmentListText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No assignments added yet"
            android:textSize="15sp"
            android:textColor="#333333"
            android:padding="10dp" />

        <!-- Dynamically Added Assignment Items and Checkboxes -->
        <LinearLayout
            android:id="@+id/assignmentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

    </LinearLayout>

</ScrollView>