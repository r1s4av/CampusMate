<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Campus Events"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#123D7A"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnTechFestDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Campus Tech Fest - View Details"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0"
            android:layout_marginBottom="16dp"
            android:padding="16dp" />

        <Button
            android:id="@+id/btnWorkshopDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI and Innovation Workshop - View Details"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0"
            android:padding="16dp" />

    </LinearLayout>
</ScrollView>
